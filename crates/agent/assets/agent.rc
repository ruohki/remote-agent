#include <winver.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,1,0
PRODUCTVERSION  0,1,1,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Remote Support"
            VALUE "FileDescription",  "Remote Support agent"
            VALUE "FileVersion",      "0.1.1"
            VALUE "InternalName",     "remote-agent"
            VALUE "OriginalFilename", "remote-agent.exe"
            VALUE "ProductName",      "Remote Support"
            VALUE "ProductVersion",   "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
